[Unit]
Description=IndoorUAV HTTP + ModeManager + ControllerHardware ROS Node — 开机启动 HTTP 服务、模式管理器与实物控制
After=network.target
Before=graphical.target

[Service]
Type=simple
User=indooruav
Environment=HOME=/home/indooruav
Environment=ROS_MASTER_URI=http://localhost:11311

ExecStart=/bin/bash -c '\
  sleep 15 && \
  source /home/indooruav/Project/IndoorUavInspection2/catkin_ws/devel/setup.bash && \
  if ! rostopic list &>/dev/null; then \
    echo "--- Starting roscore ..."; \
    roscore & \
    for i in $(seq 1 30); do \
      if rostopic list &>/dev/null; then \
        echo "--- roscore ready"; \
        break; \
      fi; \
      sleep 1; \
    done; \
  fi; \
  echo "--- Setting device permissions (i2c/ttyTHS0) ..."; \
  echo "888888" | sudo -S chmod 666 /dev/i2c-7 2>/dev/null; \
  echo "888888" | sudo -S chmod 777 /dev/ttyTHS0 2>/dev/null; \
  echo "--- Starting controller_hardware ..."; \
  bash /home/indooruav/Project/IndoorUavInspection2/catkin_ws/src/indooruav_core/shell/bringup_controller_hardware.sh & \
  echo "--- Starting mode_manager roslaunch ..."; \
  roslaunch --screen indooruav_core bringup_mode_manager.launch & \
  echo "--- Starting HTTP roslaunch ..."; \
  exec roslaunch --screen indooruav_http bringup_indooruav_http.launch'

# 停止时发送 SIGINT 给 roslaunch
KillSignal=SIGINT
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target